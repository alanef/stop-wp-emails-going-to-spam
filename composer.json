{
  "name": "fullworks/stop-wp-emails-going-to-spam-project",
  "description": "Development project for the Stop WP Emails Going to Spam WordPress plugin",
  "type": "project",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "alan",
      "email": "alan@fullworksplugins.com"
    }
  ],
  "config": {
    "platform": {
      "php": "7.4.33"
    },
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "require-dev": {
    "squizlabs/php_codesniffer": "3.*",
    "wp-coding-standards/wpcs": ">=2.3.0",
    "phpcompatibility/phpcompatibility-wp": "*",
    "phpunit/phpunit": "^9.5",
    "yoast/phpunit-polyfills": "^1.1",
    "phpstan/phpstan": "*"
  },
  "scripts": {
    "post-update-cmd": [
      "@plugin-update",
      "@make-pot"
    ],
    "plugin-update": "if [ -f stop-wp-emails-going-to-spam/composer.json ]; then composer update -d stop-wp-emails-going-to-spam; fi",
    "make-pot": "mkdir -p stop-wp-emails-going-to-spam/languages && wp i18n make-pot ./stop-wp-emails-going-to-spam ./stop-wp-emails-going-to-spam/languages/stop-wp-emails-going-to-spam.pot --skip-audit --exclude='vendor,includes/vendor,node_modules'",
    "build": [
      "if [ -f stop-wp-emails-going-to-spam/composer.json ]; then composer install -d stop-wp-emails-going-to-spam --no-dev; fi",
      "mkdir -p zipped",
      "wp dist-archive stop-wp-emails-going-to-spam zipped/stop-wp-emails-going-to-spam-free.zip --force"
    ],
    "phpcs": "phpcs stop-wp-emails-going-to-spam -s --standard=phpcs_sec.xml --ignore=*/vendor/* --extensions=php",
    "compat:8.4": "phpcs stop-wp-emails-going-to-spam -s --standard=PHPCompatibilityWP --ignore=*/vendor/* --extensions=php --runtime-set testVersion 8.4",
    "compat:8.3": "phpcs stop-wp-emails-going-to-spam -s --standard=PHPCompatibilityWP --ignore=*/vendor/* --extensions=php --runtime-set testVersion 8.3",
    "compat:8.2": "phpcs stop-wp-emails-going-to-spam -s --standard=PHPCompatibilityWP --ignore=*/vendor/* --extensions=php --runtime-set testVersion 8.2",
    "compat:8.1": "phpcs stop-wp-emails-going-to-spam -s --standard=PHPCompatibilityWP --ignore=*/vendor/* --extensions=php --runtime-set testVersion 8.1",
    "compat:8.0": "phpcs stop-wp-emails-going-to-spam -s --standard=PHPCompatibilityWP --ignore=*/vendor/* --extensions=php --runtime-set testVersion 8.0",
    "compat:7.4": "phpcs stop-wp-emails-going-to-spam -s --standard=PHPCompatibilityWP --ignore=*/vendor/* --extensions=php --runtime-set testVersion 7.4",
    "check": [
      "@compat:8.4",
      "@compat:8.3",
      "@compat:8.2",
      "@compat:8.1",
      "@compat:8.0",
      "@compat:7.4",
      "@phpcs"
    ],
    "test": "npm test"
  }
}
